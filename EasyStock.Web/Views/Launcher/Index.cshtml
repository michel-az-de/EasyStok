@model LauncherViewModel
@using System.Globalization
@{
    var ptBR = new CultureInfo("pt-BR");
    var toneClass = Model.StatusTone switch
    {
        "critical" => "ds-status--critical",
        "warning" => "ds-status--warning",
        _ => "ds-status--ok"
    };
}

@* Launcher — portal de módulos (shell modular v1)
   Reutiliza tokens.css, components.css e app-shell.css.
   Nenhuma regra CSS nova; tudo via classes existentes.
*@

<header class="ds-header mb-6">
    <h1 class="text-2xl font-bold text-slate-900">@Model.Saudacao</h1>
    <p class="ds-status @toneClass mt-1" role="status" aria-live="polite">@Model.StatusMsg</p>
    <p class="text-xs text-slate-400 mt-1">@Model.DataHoje</p>
</header>

@* ─── Atenção do dia (cards acionáveis) ─── *@
@if (Model.PedidosAbertos > 0 || Model.LotesVencendo > 0 || Model.ContasVencerHoje > 0)
{
    <section class="ws mb-6" aria-labelledby="launcher-atencao-title">
        <div class="ds-section-hd">
            <svg class="w-5 h-5" style="color:var(--orange-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <h2 id="launcher-atencao-title">Atenção do dia</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            @if (Model.PedidosAbertos > 0)
            {
                <a href="/pedidos" class="es-stat-card is-link">
                    <div class="es-stat-label">Pedidos em aberto</div>
                    <div class="es-stat-value">@Model.PedidosAbertos</div>
                    <div class="es-stat-meta">aguardando separação</div>
                </a>
            }
            @if (Model.LotesVencendo > 0)
            {
                <a href="/estoque?status=vencendo" class="es-stat-card is-link">
                    <div class="es-stat-label">Lotes vencendo</div>
                    <div class="es-stat-value">@Model.LotesVencendo</div>
                    <div class="es-stat-meta">próximos ao vencimento</div>
                </a>
            }
            @if (Model.ContasVencerHoje > 0)
            {
                <a href="/contas-a-receber" class="es-stat-card is-link">
                    <div class="es-stat-label">Contas a vencer hoje</div>
                    <div class="es-stat-value">@Model.ContasVencerHoje</div>
                    <div class="es-stat-meta">no financeiro</div>
                </a>
            }
        </div>
    </section>
}

@* ─── Pulso de hoje (atalhos rápidos) ─── *@
@if (Model.FaturamentoHoje > 0 || Model.PedidosEntreguesHoje > 0 || Model.CaixaAbertoHoje || Model.CaixaFechadoHoje)
{
    <section class="ws mb-6" aria-labelledby="launcher-pulso-title">
        <div class="ds-section-hd">
            <svg class="w-5 h-5" style="color:var(--orange-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <h2 id="launcher-pulso-title">Pulso de hoje</h2>
            <span class="ds-section-meta">resumo de @Model.DataHoje</span>
        </div>
        <div class="ds-pulse-grid">
            @if (Model.FaturamentoHoje > 0)
            {
                <div class="ds-pulse ds-pulse--accent">
                    <div class="ds-pulse-lbl">Faturamento hoje</div>
                    <div class="ds-pulse-val">@Model.FaturamentoHoje.ToString("C", ptBR)</div>
                    <div class="ds-pulse-sub">@Model.PedidosEntreguesHoje pedido@(Model.PedidosEntreguesHoje != 1 ? "s" : "") entregue@(Model.PedidosEntreguesHoje != 1 ? "s" : "")</div>
                </div>
            }
            @if (Model.CaixaAbertoHoje)
            {
                <a href="/caixa" class="ds-pulse">
                    <div class="ds-pulse-lbl">Caixa</div>
                    <div class="ds-pulse-val">@Model.SaldoCaixaAtual.ToString("C", ptBR)</div>
                    <div class="ds-pulse-sub up"><span class="ds-pulse-led"></span>caixa aberto</div>
                </a>
            }
            else if (Model.CaixaFechadoHoje)
            {
                <a href="/caixa" class="ds-pulse">
                    <div class="ds-pulse-lbl">Caixa</div>
                    <div class="ds-pulse-val">@Model.SaldoCaixaAtual.ToString("C", ptBR)</div>
                    <div class="ds-pulse-sub">fechado hoje</div>
                </a>
            }
            @if (Model.PedidosPendentes > 0)
            {
                <a href="/pedidos" class="ds-pulse">
                    <div class="ds-pulse-lbl">A entregar</div>
                    <div class="ds-pulse-val">@Model.PedidosPendentes <small>· @Model.ValorPedidosPendentes.ToString("C", ptBR)</small></div>
                    <div class="ds-pulse-sub warn">aguardando entrega · valor bruto</div>
                </a>
            }
        </div>
    </section>
}

@* ─── Módulos (cards principais) ─── *@
<section class="ws mb-6" aria-labelledby="launcher-modulos-title">
    <div class="ds-section-hd">
        <svg class="w-5 h-5" style="color:var(--navy-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        <h2 id="launcher-modulos-title">Módulos</h2>
        <span class="ds-section-meta">@Model.Modulos.Count disponíveis</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var m in Model.Modulos)
        {
            @* Href puro: o modulo vem da rota de destino (ADR-0046). Antes concatenava
               "?modulo=" cru e producao virava /estoque?status=vencido?modulo=producao. *@
            <a href="@m.Href"
               class="es-stat-card is-link"
               style="border-top: 3px solid var(--@(m.BadgeType == "crit" ? "crit" : m.BadgeType == "warn" ? "warn" : "ok")-600)">
                <div class="flex items-center justify-between">
                    <div class="es-stat-label">@m.Nome</div>
                    @if (m.BadgeCount > 0)
                    {
                        <span class="badge badge-@(m.BadgeType)">@m.BadgeCount</span>
                    }
                </div>
                <div class="flex items-center gap-3 mt-2">
                    <es-icon name="@m.Icone" class="w-8 h-8" style="color:var(--navy-600)"></es-icon>
                    <div>
                        <div class="text-sm font-medium text-slate-700">@m.Descricao</div>
                        @if (!string.IsNullOrEmpty(m.StatusText))
                        {
                            <div class="text-xs text-slate-400 mt-0.5">@m.StatusText</div>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
</section>

@* ─── Meu dia (favoritos) ─── *@
@if (Model.MeuDia.Count > 0)
{
    <section class="ws mb-6" aria-labelledby="launcher-meu-dia-title">
        <div class="ds-section-hd">
            <svg class="w-5 h-5" style="color:var(--orange-600)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <h2 id="launcher-meu-dia-title">Meu dia</h2>
        </div>
        <div class="ds-shortcuts">
            @foreach (var item in Model.MeuDia)
            {
                <a href="@item.Item.Href" class="ds-shortcut">
                    <es-icon name="@item.Item.Icon" class="es-icon--sm"></es-icon>
                    <span>@item.Item.Label</span>
                    @if (item.Badge > 0)
                    {
                        <span class="badge badge-crit">@item.Badge</span>
                    }
                </a>
            }
        </div>
    </section>
}
