.tbl-caixa tbody tr { transition: background 0.15s; }
.tbl-caixa tbody tr:hover { background: var(--ink-50); }
.tbl-caixa tbody td { padding: 14px 16px; border-bottom: 1px solid var(--ink-100); vertical-align: middle; }
.tbl-caixa tbody tr:last-child td { border-bottom: none; }
