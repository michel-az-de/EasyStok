[data-theme="dark"] .tbl-caixa tbody tr:hover { background: var(--ink-800); }
</style>
}

@section Scripts {
<script>
function _caixaModalBase(eventId) {
    return {
        open: false,
        _previousFocus: null,
        init() {
            window.addEventListener('open-modal', (e) => {
                if (e.detail !== eventId) return;
                this._previousFocus = document.activeElement;
                this.open = true;
                this.$nextTick(() => {
                    const el = this.$refs.panel?.querySelector('input:not([type=hidden]), select, textarea');
                    if (el) el.focus();
                });
            });
            this.$watch('open', (v) => {
                document.body.style.overflow = v ? 'hidden' : '';
                if (!v && this._previousFocus) this._previousFocus.focus?.();
            });
        },
        close() { this.open = false; }
    };
}

function abrirCaixaModal()       { return _caixaModalBase('abrir-caixa'); }
function fecharCaixaModal()      { return _caixaModalBase('fechar-caixa'); }
function lancamentoCaixaModal()  {
    return Object.assign(_caixaModalBase('lancar-mov'), {
        tipo: 'entrada',
        saldoDisponivel: @(d is null ? "0" : d.SaldoEsperado.ToString(System.Globalization.CultureInfo.InvariantCulture)),
        erroSaldo: '',
        validarSubmit(ev) {
            this.erroSaldo = '';
            if (this.tipo !== 'saida') return;
            const inp = ev.target.querySelector('input[name=valor]');
            const v = parseFloat(String((inp && inp.value) || '0').replace(',', '.')) || 0;
            if (v > this.saldoDisponivel) {
                ev.preventDefault();
                const f = n => 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                this.erroSaldo = 'Saída de ' + f(v) + ' é maior que o saldo disponível (' + f(this.saldoDisponivel) + '). O caixa não pode ficar negativo.';
                if (inp) inp.focus();
            }
        }
    });
}

function caixaAutoRetry(enabled) {
    return {
        enabled: enabled,
        attempts: 0,
        maxAttempts: 3,
        delays: [5, 10, 20],
        countdown: 0,
        retrying: false,
        exhausted: false,
        _tickHandle: null,

        start() {
            if (!this.enabled) return;
            this.scheduleNext();
        },
        scheduleNext() {
            if (this.attempts >= this.maxAttempts) {
                this.exhausted = true;
                return;
            }
            this.countdown = this.delays[this.attempts] || 30;
            clearInterval(this._tickHandle);
            this._tickHandle = setInterval(() => {
                this.countdown -= 1;
                if (this.countdown <= 0) {
                    clearInterval(this._tickHandle);
                    this.retryNow();
                }
            }, 1000);
        },
        async retryNow() {
            if (this.retrying) return;
            clearInterval(this._tickHandle);
            this.retrying = true;
            this.attempts += 1;
            try {
                const r = await esFetch(window.location.pathname + window.location.search, {
                    method: 'GET',
                    headers: { 'X-Probe': '1' },
                    credentials: 'same-origin',
                    cache: 'no-store'
                });
                if (r.ok) {
                    window.location.reload();
                    return;
                }
                this.retrying = false;
                this.scheduleNext();
            } catch (e) {
                this.retrying = false;
                this.scheduleNext();
            }
        },
        cancel() {
            clearInterval(this._tickHandle);
            this.enabled = false;
            this.exhausted = true;
        }
    };
}
</script>
}
