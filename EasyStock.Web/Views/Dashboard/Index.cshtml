@model DashboardViewModel
@using System.Globalization
@{
    var ptBR = new CultureInfo("pt-BR");
    var hora = DateTime.Now.Hour;
    var saudacao = hora < 12 ? "Bom dia" : hora < 18 ? "Boa tarde" : "Boa noite";
    var primeiroNome = (ViewBag.UsuarioNome as string ?? "").Split(' ').First();
}

<div class="pg-hd mb-6">
    <h1>@saudacao, @primeiroNome!</h1>
    <p>Aqui está um resumo do seu estoque hoje, @DateTime.Now.ToString("dd 'de' MMMM", ptBR).</p>
</div>

<div class="dashboard-kpi-grid grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="ws dashboard-kpi-card dashboard-kpi-card--catalog">
        <div class="dashboard-kpi-top">
            <div>
                <div class="kpi-lbl">Total de SKUs</div>
                <div class="kpi-val dashboard-kpi-value text-slate-900">@Model.TotalProdutos</div>
            </div>
            <div class="dashboard-kpi-icon dashboard-kpi-icon--catalog" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
        </div>
    </div>
    <div class="ws dashboard-kpi-card dashboard-kpi-card--stock">
        <div class="dashboard-kpi-top">
            <div>
                <div class="kpi-lbl">Itens em estoque</div>
                <div class="kpi-val dashboard-kpi-value text-emerald-600">@Model.QuantidadeTotalEmEstoque</div>
            </div>
            <div class="dashboard-kpi-icon dashboard-kpi-icon--stock" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5 2a8 8 0 11-16 0 8 8 0 0116 0z" />
                </svg>
            </div>
        </div>
    </div>
    <div class="ws dashboard-kpi-card dashboard-kpi-card--value">
        <div class="dashboard-kpi-top">
            <div>
                <div class="kpi-lbl">Valor em estoque</div>
                <div class="kpi-val dashboard-kpi-value text-indigo-600">@Model.ValorEstoque.ToString("C", ptBR)</div>
            </div>
            <div class="dashboard-kpi-icon dashboard-kpi-icon--value" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-2.21 0-4 .9-4 2s1.79 2 4 2 4 .9 4 2-1.79 2-4 2m0-8V6m0 10v2m8-6a8 8 0 11-16 0 8 8 0 0116 0z" />
                </svg>
            </div>
        </div>
    </div>
    <div class="ws dashboard-kpi-card dashboard-kpi-card--revenue">
        <div class="dashboard-kpi-top">
            <div>
                <div class="kpi-lbl">Receita estimada</div>
                <div class="kpi-val dashboard-kpi-value text-emerald-700">@Model.ReceitaMes.ToString("C", ptBR)</div>
            </div>
            <div class="dashboard-kpi-icon dashboard-kpi-icon--revenue" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5m0 14h16M8 15l3-3 3 2 5-6" />
                </svg>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-kpi-grid grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <a href="/estoque?status=critico" class="ws dashboard-kpi-card dashboard-attention-card flex items-center gap-3 hover:border-red-300 transition-colors cursor-pointer">
        <div class="dashboard-attention-icon dashboard-attention-icon--critical">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M10.29 3.86l-7.11 12.3A2 2 0 004.91 19h14.18a2 2 0 001.73-2.84l-7.11-12.3a2 2 0 00-3.42 0z" />
            </svg>
        </div>
        <div>
            <div class="kpi-val dashboard-kpi-value dashboard-kpi-value--attention text-red-600">@Model.EstoqueCritico</div>
            <div class="kpi-lbl">Estoque crítico</div>
        </div>
    </a>
    <a href="/estoque?status=atencao" class="ws dashboard-kpi-card dashboard-attention-card flex items-center gap-3 hover:border-amber-300 transition-colors cursor-pointer">
        <div class="dashboard-attention-icon dashboard-attention-icon--warning">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div>
            <div class="kpi-val dashboard-kpi-value dashboard-kpi-value--attention text-amber-600">@Model.ProximosVencimento</div>
            <div class="kpi-lbl">Próx. ao vencimento</div>
        </div>
    </a>
    <a href="/estoque?status=parado" class="ws dashboard-kpi-card dashboard-attention-card flex items-center gap-3 hover:border-blue-300 transition-colors cursor-pointer">
        <div class="dashboard-attention-icon dashboard-attention-icon--info">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 13.5h10M9 17h6M8 6h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2z" />
            </svg>
        </div>
        <div>
            <div class="kpi-val dashboard-kpi-value dashboard-kpi-value--attention text-blue-600">@Model.ProdutosParados</div>
            <div class="kpi-lbl">Parados +30 dias</div>
        </div>
    </a>
    <a href="/entradas/reposicao" class="ws dashboard-kpi-card dashboard-attention-card flex items-center gap-3 hover:border-emerald-300 transition-colors cursor-pointer">
        <div class="dashboard-attention-icon dashboard-attention-icon--success">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v2.5m0 13V21m7.07-14.07l-1.77 1.77M6.7 17.3l-1.77 1.77M21 12h-2.5M5.5 12H3m14.3 5.3l1.77 1.77M6.93 6.93L5.16 5.16M15.5 12a3.5 3.5 0 11-7 0 3.5 3.5 0 017 0z" />
            </svg>
        </div>
        <div>
            <div class="kpi-val dashboard-kpi-value dashboard-kpi-value--attention text-emerald-600">@Model.SugestoesReposicao</div>
            <div class="kpi-lbl">Sugestões de reposição</div>
        </div>
    </a>
</div>

<div class="grid grid-cols-1 gap-6 mb-6">
    <div class="ws">
        <h2 class="font-bold text-slate-800 mb-4">Movimentações recentes</h2>
        @if (Model.MovimentacoesRecentes.Any())
        {
            <div class="overflow-x-auto">
                <table class="tbl-full">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th class="text-right">Registros</th>
                            <th class="text-right">Qtd</th>
                            <th class="text-right">Valor</th>
                            <th class="text-right">Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MovimentacoesRecentes)
                        {
                            <tr>
                                <td>
                                    @{
                                        var badgeClass = m.Tipo switch
                                        {
                                            "Entrada" => "badge-ok",
                                            "Saida" or "Saída" => "badge-critical",
                                            _ => "badge-slow"
                                        };
                                        var tipoLabel = m.Tipo is "Saida" ? "Saída" : m.Tipo;
                                    }
                                    <span class="badge @badgeClass px-2 py-0.5 rounded-full text-xs font-semibold">@tipoLabel</span>
                                </td>
                                <td class="text-right text-slate-500">@m.TotalMovimentacoes</td>
                                <td class="text-right font-mono">@m.Qty</td>
                                <td class="text-right text-slate-500">
                                    @if (m.Valor.HasValue)
                                    {
                                        @m.Valor.Value.ToString("C", ptBR)
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="text-right text-slate-500">@m.Data.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-8 text-slate-400">
                <div class="empty-state-mark mb-2">MOV</div>
                <p class="text-sm font-semibold text-slate-500">Nenhuma movimentação ainda</p>
                <p class="text-xs mt-1">Registre sua primeira <a href="/entradas/nova" class="text-indigo-600 hover:underline">entrada de estoque</a> para começar.</p>
            </div>
        }
    </div>

    <div class="ws dashboard-chart-card">
        <h2 class="font-bold text-slate-800 mb-4">Receita — últimos @Model.GraficoLabels.Count @(Model.GraficoLabels.Count == 1 ? "mês" : "meses")</h2>
        @if (Model.GraficoLabels.Any())
        {
            <div class="dashboard-chart-wrap">
                <canvas id="grafico-receita" height="260"></canvas>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center min-h-[240px] text-slate-400">
                <div class="empty-state-mark mb-3">R$</div>
                <p class="text-sm font-semibold text-slate-500">Sem dados de receita</p>
                <p class="text-xs mt-1">Registre saídas para visualizar o gráfico.</p>
            </div>
        }
    </div>
</div>

<div class="ws">
    <h2 class="font-bold text-slate-800 mb-4">Ações rápidas</h2>
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
        @{
            var acoes = new[]
            {
                new { Icon = "IN", Label = "Nova entrada", Href = "/entradas/nova" },
                new { Icon = "OUT", Label = "Nova saída", Href = "/saidas/nova" },
                new { Icon = "REP", Label = "Repor estoque", Href = "/entradas/reposicao" },
                new { Icon = "EST", Label = "Ver estoque", Href = "/estoque" },
                new { Icon = "IA", Label = "Gerar anúncio", Href = "/anuncios" },
                new { Icon = "MOV", Label = "Movimentações", Href = "/analytics/movimentacoes" },
            };
        }
        @foreach (var acao in acoes)
        {
            <a href="@acao.Href"
               class="quick-action-card flex flex-col items-center gap-2 p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50 transition-all text-center">
                <span class="quick-action-icon text-2xl">@acao.Icon</span>
                <span class="text-xs font-semibold text-slate-600">@acao.Label</span>
            </a>
        }
    </div>
</div>

@section Scripts {
    @if (Model.GraficoLabels.Any())
    {
    <script>
        const chartCanvas = document.getElementById('grafico-receita');
        if (chartCanvas) {
            const chartContext = chartCanvas.getContext('2d');
            const isDark = document.documentElement.classList.contains('theme-dark');
            const lineGradient = chartContext.createLinearGradient(0, 0, chartCanvas.clientWidth || 640, 0);
            lineGradient.addColorStop(0, '#4F46E5');
            lineGradient.addColorStop(.52, '#0891B2');
            lineGradient.addColorStop(1, '#059669');

            const fillGradient = chartContext.createLinearGradient(0, 0, 0, 280);
            fillGradient.addColorStop(0, isDark ? 'rgba(99, 102, 241, .24)' : 'rgba(79, 70, 229, .18)');
            fillGradient.addColorStop(.55, isDark ? 'rgba(8, 145, 178, .10)' : 'rgba(8, 145, 178, .08)');
            fillGradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            new Chart(chartCanvas, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoLabels)),
                    datasets: [{
                        label: 'Receita',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoDados)),
                        borderColor: lineGradient,
                        backgroundColor: fillGradient,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: isDark ? '#C7D2FE' : '#FFFFFF',
                        pointBorderColor: '#4F46E5',
                        pointBorderWidth: 2,
                        fill: true,
                        tension: 0.4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isDark ? 'rgba(15, 23, 42, .96)' : 'rgba(255, 255, 255, .96)',
                            titleColor: isDark ? '#F8FAFC' : '#0F172A',
                            bodyColor: isDark ? '#CBD5E1' : '#334155',
                            borderColor: isDark ? 'rgba(71, 85, 105, .8)' : 'rgba(226, 232, 240, .9)',
                            borderWidth: 1,
                            padding: 12,
                            cornerRadius: 12,
                            displayColors: false,
                            callbacks: {
                                label: ctx => 'Receita: ' + Number(ctx.parsed.y || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: isDark ? '#94A3B8' : '#64748B',
                                font: { size: 11, weight: 600 }
                            },
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            ticks: {
                                color: isDark ? '#94A3B8' : '#64748B',
                                padding: 10,
                                font: { size: 11, weight: 600 },
                                callback: v => Number(v).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 })
                            },
                            grid: {
                                color: isDark ? 'rgba(71, 85, 105, .42)' : 'rgba(148, 163, 184, .18)',
                                drawBorder: false
                            }
                        }
                    }
                }
            });
        }
    </script>
    }
}
