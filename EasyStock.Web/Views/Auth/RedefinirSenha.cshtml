@model ResetPasswordViewModel
@{
    Layout = null;
    ViewBag.Title = "Redefinir senha";
}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redefinir senha - EasyStock</title>
    <script>
        (function () {
            const stored = localStorage.getItem('easystock-theme');
            const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle('theme-dark', theme === 'dark');
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' };</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="h-full font-[Inter] antialiased min-h-screen" style="background-color:var(--app-bg);background-image:var(--app-bg-image);">
    <div class="auth-login-shell min-h-screen px-4 py-6 md:px-6 lg:px-8">
        <div class="w-full max-w-md mx-auto">
            <div class="mb-7 text-center">
                <div class="inline-flex items-center gap-3 mb-3">
                    <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 text-lg font-extrabold">ES</span>
                    <span class="text-3xl font-extrabold tracking-tight auth-title">EasyStock</span>
                </div>
                <p class="auth-kicker mb-2">Nova credencial</p>
                <h1 class="text-3xl font-extrabold tracking-tight auth-title">Criar nova senha</h1>
                <p class="auth-subtitle text-sm mt-2">Use uma senha forte, diferente da anterior.</p>
            </div>

            <div class="auth-card rounded-3xl shadow-2xl p-6 md:p-8">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert-error text-sm rounded-xl px-4 py-3 mb-5">
                        @Html.ValidationSummary(false, "", new { @class = "" })
                    </div>
                }

                <form asp-action="RedefinirSenha" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Token" type="hidden" />

                    <div class="mb-4">
                        <label asp-for="NovaSenha" class="block text-sm font-semibold auth-label mb-1.5">Nova senha</label>
                        <input asp-for="NovaSenha" type="password" autocomplete="new-password"
                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                               placeholder="Mínimo 8 caracteres" />
                        <span asp-validation-for="NovaSenha" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-6">
                        <label asp-for="ConfirmarSenha" class="block text-sm font-semibold auth-label mb-1.5">Confirmar nova senha</label>
                        <input asp-for="ConfirmarSenha" type="password" autocomplete="new-password"
                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                               placeholder="Repita a senha" />
                        <span asp-validation-for="ConfirmarSenha" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs leading-6 text-slate-500">
                        Combine letras maiúsculas, minúsculas, números e caracteres especiais.
                    </div>

                    <button type="submit" class="auth-submit-btn w-full text-white font-semibold py-3 rounded-xl text-sm">
                        Redefinir senha
                    </button>
                </form>
            </div>

            <p class="text-center text-xs auth-footer mt-6">
                &copy; @DateTime.Now.Year EasyStock. Todos os direitos reservados.
            </p>
        </div>
    </div>
</body>
</html>
