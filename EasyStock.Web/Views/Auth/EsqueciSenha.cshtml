@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewBag.Title = "Esqueci minha senha";
}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Esqueci minha senha - EasyStock</title>
    <script>
        (function () {
            const stored = localStorage.getItem('easystock-theme');
            const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle('theme-dark', theme === 'dark');
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' };</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="h-full font-[Inter] antialiased min-h-screen" style="background-color:var(--app-bg);background-image:var(--app-bg-image);">
    <div class="auth-login-shell min-h-screen px-4 py-6 md:px-6 lg:px-8">
        <div class="w-full max-w-md mx-auto">
            <div class="mb-7 text-center">
                <div class="inline-flex items-center gap-3 mb-3">
                    <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 text-lg font-extrabold">ES</span>
                    <span class="text-3xl font-extrabold tracking-tight auth-title">EasyStock</span>
                </div>
                <p class="auth-kicker mb-2">Acesso seguro</p>
                <h1 class="text-3xl font-extrabold tracking-tight auth-title">Recuperar senha</h1>
                <p class="auth-subtitle text-sm mt-2">Informe seu e-mail para receber as instruções de redefinição.</p>
            </div>

            <div class="auth-card rounded-3xl shadow-2xl p-6 md:p-8">
                @if (ViewBag.Sent == true)
                {
                    <div class="auth-alert-warn text-sm rounded-xl px-4 py-3 mb-5">
                        Se o e-mail estiver cadastrado, você receberá as instruções em breve.
                    </div>
                    <a href="/auth/login" class="auth-submit-btn w-full text-white font-semibold py-3 rounded-xl text-sm flex items-center justify-center">
                        Voltar para o login
                    </a>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="auth-alert-error text-sm rounded-xl px-4 py-3 mb-5">
                            @Html.ValidationSummary(false, "", new { @class = "" })
                        </div>
                    }

                    <form asp-action="EsqueciSenha" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-6">
                            <label asp-for="Email" class="block text-sm font-semibold auth-label mb-1.5">E-mail</label>
                            <input asp-for="Email" type="email" autocomplete="email"
                                   class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                   placeholder="seu@email.com" />
                            <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <button type="submit" class="auth-submit-btn w-full text-white font-semibold py-3 rounded-xl text-sm">
                            Enviar instruções
                        </button>
                    </form>

                    <a href="/auth/login" class="block text-center text-sm auth-subtitle hover:text-indigo-500 mt-5">
                        Voltar para o login
                    </a>
                }
            </div>

            <p class="text-center text-xs auth-footer mt-6">
                &copy; @DateTime.Now.Year EasyStock. Todos os direitos reservados.
            </p>
        </div>
    </div>
</body>
</html>
