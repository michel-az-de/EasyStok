@model List<Loja>
@{
    Layout = null;
    ViewBag.Title = "Selecionar loja";
}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Selecionar loja - EasyStock</title>
    <script>
        (function () {
            const stored = localStorage.getItem('easystock-theme');
            const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle('theme-dark', theme === 'dark');
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' };</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="h-full font-[Inter] antialiased min-h-screen" style="background-color:var(--app-bg);background-image:var(--app-bg-image);">
    <div class="auth-login-shell min-h-screen px-4 py-6 md:px-6 lg:px-8">
        <div class="w-full max-w-2xl mx-auto">
            <div class="text-center mb-8">
                <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 text-lg font-extrabold">ES</span>
                <p class="auth-kicker mt-4 mb-2">Contexto de trabalho</p>
                <h1 class="text-3xl font-extrabold auth-title">Selecionar loja</h1>
                <p class="auth-subtitle text-sm mt-2">Escolha a loja que você deseja gerenciar agora.</p>
            </div>

            @if (Model.Any())
            {
                <div class="grid gap-3">
                    @foreach (var loja in Model)
                    {
                        var lojaInicial = !string.IsNullOrWhiteSpace(loja.Nome) ? loja.Nome.Trim()[0].ToString().ToUpperInvariant() : "L";
                        <form asp-action="SelecionarLoja" asp-controller="Auth" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lojaId" value="@loja.Id" />
                            <input type="hidden" name="lojaNome" value="@loja.Nome" />
                            <input type="hidden" name="lojaEmoji" value="@loja.Emoji" />
                            <input type="hidden" name="empresaId" value="@loja.EmpresaId" />
                            <button type="submit" class="auth-loja-card w-full rounded-2xl p-5 text-left flex items-center gap-4 transition-all shadow-sm group">
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 text-lg font-extrabold">@lojaInicial</span>
                                <span class="min-w-0">
                                    <span class="block font-bold auth-card-title group-hover:text-indigo-500 transition-colors truncate">@loja.Nome</span>
                                    <span class="block auth-card-subtitle text-sm truncate">@loja.Cidade · @loja.Plano</span>
                                </span>
                                <svg class="ml-auto w-5 h-5 auth-icon-muted group-hover:text-indigo-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="auth-card rounded-3xl p-8 text-center shadow-2xl">
                    <p class="auth-card-title font-bold">Nenhuma loja encontrada</p>
                    <p class="auth-card-subtitle text-sm mt-2">Seu usuário ainda não está vinculado a uma loja ativa.</p>
                    <form asp-action="Logout" asp-controller="Auth" method="post" class="mt-5">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="auth-submit-btn px-5 py-3 rounded-xl text-white text-sm font-semibold">Fazer logout</button>
                    </form>
                </div>
            }
        </div>
    </div>
</body>
</html>
