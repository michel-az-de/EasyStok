@model RegisterViewModel
@{
    Layout = null;
    ViewBag.Title = "Criar conta";
}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Criar conta - EasyStock</title>
    <script>
        (function () {
            const stored = localStorage.getItem('easystock-theme');
            const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle('theme-dark', theme === 'dark');
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="h-full font-[Inter] antialiased min-h-screen" style="background-color:var(--app-bg);background-image:var(--app-bg-image);">
    <div class="auth-login-shell min-h-screen px-4 py-6 md:px-6 lg:px-8">
        <div class="auth-register-layout mx-auto grid w-full max-w-6xl overflow-hidden rounded-[2rem] border border-white/60 shadow-2xl shadow-slate-900/10">
            <section class="auth-login-brand hidden lg:flex lg:flex-col lg:justify-between">
                <div>
                    <div class="inline-flex items-center gap-3 mb-6">
                        <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-lg shadow-indigo-950/15 text-lg font-extrabold">ES</span>
                        <span class="text-3xl font-extrabold tracking-tight text-white">EasyStock</span>
                    </div>
                    <p class="text-sm uppercase tracking-[0.35em] text-white/65 mb-4">Primeiro acesso</p>
                    <h1 class="max-w-md text-4xl font-extrabold leading-tight text-white">Organize a operação antes que o estoque vire urgência.</h1>
                    <p class="mt-4 max-w-lg text-base leading-7 text-white/78">Crie sua empresa, convide o time e comece com uma base pronta para produtos, entradas, saídas e alertas inteligentes.</p>
                </div>

                <div class="grid grid-cols-2 gap-3 text-sm text-white/78">
                    <div class="auth-login-brand-stat">
                        <span class="auth-login-brand-stat__value">Setup</span>
                        <span class="auth-login-brand-stat__label">Empresa e administrador no mesmo fluxo</span>
                    </div>
                    <div class="auth-login-brand-stat">
                        <span class="auth-login-brand-stat__value">Rotina</span>
                        <span class="auth-login-brand-stat__label">Base pronta para estoque, vendas e reposição</span>
                    </div>
                </div>
            </section>

            <section class="auth-login-panel auth-register-panel">
                <div class="w-full max-w-2xl mx-auto">
                    <div class="mb-7 text-center lg:text-left">
                        <div class="inline-flex items-center gap-3 mb-3 lg:hidden">
                            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 text-lg font-extrabold">ES</span>
                            <span class="text-3xl font-extrabold tracking-tight auth-title">EasyStock</span>
                        </div>
                        <p class="auth-kicker mb-2">Comece em poucos minutos</p>
                        <h2 class="text-3xl font-extrabold tracking-tight auth-title">Criar conta</h2>
                        <p class="auth-subtitle text-sm mt-2">Preencha os dados principais para abrir sua operação.</p>
                    </div>

                    <div class="auth-card rounded-3xl shadow-2xl p-6 md:p-8">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="auth-alert-error text-sm rounded-xl px-4 py-3 mb-5">
                                @Html.ValidationSummary(false, "", new { @class = "" })
                            </div>
                        }

                        <form asp-action="Registrar" asp-controller="Auth" method="post">
                            @Html.AntiForgeryToken()

                            <div class="auth-form-section">
                                <div class="auth-form-section__header">
                                    <span class="auth-step-badge">1</span>
                                    <div>
                                        <p class="auth-section-title">Sua empresa</p>
                                        <p class="auth-section-subtitle">Identificação usada em lojas, relatórios e permissões.</p>
                                    </div>
                                </div>

                                <div class="grid gap-4 md:grid-cols-2">
                                    <div class="md:col-span-2">
                                        <label asp-for="NomeEmpresa" class="block text-sm font-semibold auth-label mb-1.5">Nome da empresa *</label>
                                        <input asp-for="NomeEmpresa" type="text" autocomplete="organization"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="Ex: Minha Loja Ltda" />
                                        <span asp-validation-for="NomeEmpresa" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label asp-for="Documento" class="block text-sm font-semibold auth-label mb-1.5">
                                            CNPJ / CPF <span class="text-slate-400 font-normal">(opcional)</span>
                                        </label>
                                        <input asp-for="Documento" type="text"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="00.000.000/0001-00" />
                                    </div>
                                </div>
                            </div>

                            <div class="auth-form-section">
                                <div class="auth-form-section__header">
                                    <span class="auth-step-badge">2</span>
                                    <div>
                                        <p class="auth-section-title">Administrador</p>
                                        <p class="auth-section-subtitle">Este usuário terá acesso inicial à conta.</p>
                                    </div>
                                </div>

                                <div class="grid gap-4 md:grid-cols-2">
                                    <div class="md:col-span-2">
                                        <label asp-for="NomeAdmin" class="block text-sm font-semibold auth-label mb-1.5">Seu nome *</label>
                                        <input asp-for="NomeAdmin" type="text" autocomplete="name"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="Nome completo" />
                                        <span asp-validation-for="NomeAdmin" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label asp-for="Email" class="block text-sm font-semibold auth-label mb-1.5">E-mail *</label>
                                        <input asp-for="Email" type="email" autocomplete="email"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="seu@email.com" />
                                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                    <div>
                                        <label asp-for="Senha" class="block text-sm font-semibold auth-label mb-1.5">Senha *</label>
                                        <input asp-for="Senha" type="password" autocomplete="new-password"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="Mínimo 8 caracteres" />
                                        <span asp-validation-for="Senha" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                    <div>
                                        <label asp-for="ConfirmarSenha" class="block text-sm font-semibold auth-label mb-1.5">Confirmar senha *</label>
                                        <input asp-for="ConfirmarSenha" type="password" autocomplete="new-password"
                                               class="auth-input w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all"
                                               placeholder="Repita a senha" />
                                        <span asp-validation-for="ConfirmarSenha" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit"
                                    class="auth-submit-btn w-full text-white font-semibold py-3 rounded-xl text-sm flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/25">
                                Criar conta grátis
                            </button>
                        </form>
                    </div>

                    <p class="text-center text-sm auth-subtitle mt-5 lg:text-left">
                        Já tem uma conta?
                        <a href="/auth/login" class="text-indigo-500 hover:text-indigo-400 font-medium">Entrar</a>
                    </p>

                    <p class="text-center text-xs auth-footer mt-4 lg:text-left">
                        &copy; @DateTime.Now.Year EasyStock. Todos os direitos reservados.
                    </p>
                </div>
            </section>
        </div>
    </div>
    <script src="~/js/toast.js"></script>
</body>
</html>
