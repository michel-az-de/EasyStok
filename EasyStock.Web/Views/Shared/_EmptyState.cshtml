@{
    var icon = ViewData["EmptyIcon"] as string;
    var title = ViewData["EmptyTitle"] as string ?? "Nenhum item encontrado";
    var description = ViewData["EmptyDescription"] as string;
    var ctaText = ViewData["EmptyCta"] as string;
    var ctaHref = ViewData["EmptyCtaHref"] as string;
    var ctaModal = ViewData["EmptyCtaModal"] as string;
}

<div class="empty-state text-center py-12 text-slate-400">
    @if (!string.IsNullOrWhiteSpace(icon))
    {
        <div class="text-5xl mb-3">@icon</div>
    }
    else
    {
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-500 ring-1 ring-indigo-100">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
        </div>
    }
    <p class="font-semibold text-slate-700">@title</p>
    @if (!string.IsNullOrEmpty(description))
    {
        <p class="text-sm mt-1 text-slate-500 max-w-sm mx-auto">@description</p>
    }
    @if (!string.IsNullOrEmpty(ctaHref))
    {
        <a href="@ctaHref" class="mt-4 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-50 transition-colors">
            @ctaText
        </a>
    }
    else if (!string.IsNullOrEmpty(ctaModal))
    {
        <button type="button" x-data @@click="$dispatch('open-modal', '@ctaModal')"
                class="mt-4 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-50 transition-colors">
            @ctaText
        </button>
    }
</div>
