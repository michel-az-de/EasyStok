    "etiqueta": "node ferramentas/prova-2247-etiqueta-motor.mjs",
    "impressaoHonesta": "node ferramentas/prova-2377-impressao-honesta.mjs",
    "escritas": "node ferramentas/prova-2379-escritas.mjs",
    "tela-sem-branco": "node ferramentas/prova-2393-tela-sem-branco.mjs",
    "borda-http": "node ferramentas/prova-2392-borda-http.mjs",
    "caixa-ao-vivo": "node ferramentas/prova-2378-caixa-ao-vivo.mjs",
    "qualidade": "npm run lint && npm run camadas && npm run gramatica && npm run reais && npm run contraste && npm run etiqueta && npm run impressaoHonesta && npm run caixa-ao-vivo && npm run escritas && npm run borda-http && npm run tela-sem-branco && npm run build",
