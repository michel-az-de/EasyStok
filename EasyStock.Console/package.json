    "preview": "vite preview",
    "lint": "oxlint",
    "camadas": "node ferramentas/verificar-camadas.mjs",
    "gramatica": "node ferramentas/verificar-gramatica.mjs",
    "reais": "node ferramentas/verificar-reais.mjs && node ferramentas/prova-2080-reais.mjs",
