# Serviço "api-falsa": só o servidor/agente.mjs, sem build. Sobe com
# AGENTE_MODO=falso (ver compose.yaml), sem cli nem chave de API.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY servidor ./servidor
EXPOSE 5245
CMD ["node", "servidor/agente.mjs"]
