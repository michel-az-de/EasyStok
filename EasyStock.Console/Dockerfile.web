# Serviço "web": build da SPA (vite-plugin-singlefile gera dist/index.html
# num arquivo só) e depois serve por nginx, com proxy de /api/ para api-falsa.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
