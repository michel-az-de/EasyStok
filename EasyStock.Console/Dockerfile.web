# Serviço "web": build da SPA (vite-plugin-singlefile gera dist/index.html
# num arquivo só) e depois serve por nginx, com proxy de /api/.
#
# F13 (#1243): o mesmo arquivo gera os dois modos.
#   Demonstração (padrão): sem build args; /api/ vai para o api-falsa do protótipo.
#   Modo API:  --build-arg VITE_FONTE_DADOS=api  e, no contêiner,  API_UPSTREAM=http://ez-api:8080
#              (VITE_API_BASE vazio = mesma origem: o nginx repassa /api/ para a API real).
FROM node:24-alpine AS build
ARG VITE_FONTE_DADOS=
ARG VITE_API_BASE=
ENV VITE_FONTE_DADOS=$VITE_FONTE_DADOS VITE_API_BASE=$VITE_API_BASE
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
# O nginx oficial passa /etc/nginx/templates/*.template pelo envsubst ao subir
# (só as variáveis definidas, então $host e afins ficam como estão).
ENV API_UPSTREAM=http://api-falsa:5245
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
