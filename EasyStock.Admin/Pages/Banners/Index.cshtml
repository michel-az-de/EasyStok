@page
@model EasyStock.Admin.Pages.Banners.IndexModel
@{
    ViewData["Title"] = "Quadro de avisos";

    (string Variant, string Label, bool Dot) Situacao(BannerEstado e) => e switch
    {
        BannerEstado.NoAr => ("ok", "No ar", true),
        BannerEstado.Agendado => ("info", "Agendado", false),
        BannerEstado.Expirado => ("warn", "Expirado", false),
        _ => ("neutral", "Inativo", false)
    };
}

<style>
    .aviso-thumb {
        width: 44px;
        height: 44px;
        border-radius: var(--r-md);
        border: 1px solid var(--border-soft);
        background: var(--surface-sunken);
        flex-shrink: 0;
    }
    img.aviso-thumb { object-fit: cover; }
    span.aviso-thumb {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
    }
    .aviso-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        line-height: 1;
        color: var(--text-secondary);
        background: var(--surface-sunken);
        border: 1px solid var(--border-soft);
        border-radius: var(--r-pill);
        padding: 3px 8px;
    }
    .aviso-chip .es-icon { color: var(--text-muted); }
</style>

<es-page-header eyebrow="Comunicação"
                titulo="Quadro de avisos"
                descricao="Avisos exibidos a todos os lojistas no app Web — imagem clicável ou mensagem em modal.">
    <es-page-header-breadcrumb>
        <es-breadcrumb>
            <es-breadcrumb-item href="/">Dashboard</es-breadcrumb-item>
            <es-breadcrumb-item>Quadro de avisos</es-breadcrumb-item>
        </es-breadcrumb>
    </es-page-header-breadcrumb>
    <es-button variant="primary" href="/Banners/Edit" icon="plus">Novo aviso</es-button>
</es-page-header>

<es-filter-bar>
    <es-button variant="@(Model.Ativo == null ? "primary" : "ghost")" size="xs" href="/Banners">Todos</es-button>
    <es-button variant="@(Model.Ativo == true ? "primary" : "ghost")" size="xs" href="/Banners?ativo=1">Ativos</es-button>
    <es-button variant="@(Model.Ativo == false ? "primary" : "ghost")" size="xs" href="/Banners?ativo=0">Inativos</es-button>
</es-filter-bar>

<es-data-table is-empty="@(!Model.Itens.Any())">
    <es-data-table-column label="Aviso" />
    <es-data-table-column label="Situação" />
    <es-data-table-column label="Janela (BRT)" />
    <es-data-table-column label="Prioridade" align="right" />
    <es-data-table-column label="" actions="true" width="240px" />

    @foreach (var b in Model.Itens)
    {
        var s = Situacao(b.Estado);
        <tr>
            <td data-label="Aviso">
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (b.EhImagem && !string.IsNullOrWhiteSpace(b.ImagemUrl))
                    {
                        <img src="@b.ImagemUrl" alt="" loading="lazy" class="aviso-thumb"
                             onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
                        <span class="aviso-thumb" style="display:none;" aria-hidden="true" title="Imagem indisponível"><es-icon name="alert-triangle" size="18" /></span>
                    }
                    else
                    {
                        <span class="aviso-thumb"><es-icon name="@(b.EhImagem ? "alert-triangle" : "info")" size="18" /></span>
                    }
                    <div style="min-width:0;">
                        <div style="font-weight:600; color:var(--text-primary);">@b.Titulo</div>
                        <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">@(b.EhImagem ? "Imagem" : "Mensagem")</div>
                        @if (b.ExigeConfirmacao || b.Unica || b.Notifica)
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
                                @if (b.ExigeConfirmacao)
                                {
                                    <span class="aviso-chip"><es-icon name="check-circle" size="11" /> Confirmação</span>
                                }
                                @if (b.Unica)
                                {
                                    <span class="aviso-chip"><es-icon name="eye" size="11" /> 1× por usuário</span>
                                }
                                @if (b.Notifica)
                                {
                                    <span class="aviso-chip"><es-icon name="bell" size="11" /> Notifica</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </td>
            <td data-label="Situação">
                <es-badge variant="@s.Variant" with-dot="@s.Dot">@s.Label</es-badge>
            </td>
            <td data-label="Janela (BRT)" style="color:var(--text-muted); font-size:12px;">@b.Janela</td>
            <td data-label="Prioridade" class="es-data-table-td-numeric">@b.Prioridade</td>
            <td class="es-data-table-td-actions">
                <div class="es-row-actions">
                    <es-button variant="ghost" size="xs" icon="edit-2" href="/Banners/Edit/@b.Id">Editar</es-button>
                    @if (b.Estado == BannerEstado.Inativo)
                    {
                        <form method="post" asp-page-handler="Ativar" asp-route-id="@b.Id" style="display:inline;">
                            <es-button type="submit" variant="ghost" size="xs" icon="check">Ativar</es-button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Desativar" asp-route-id="@b.Id" style="display:inline;">
                            <es-button type="submit" variant="ghost" size="xs" icon="eye-off">Desativar</es-button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Excluir" asp-route-id="@b.Id" style="display:inline;"
                          onsubmit="return confirm('Excluir este aviso? Se houver confirmações registradas, use Desativar.');">
                        <es-button type="submit" variant="ghost" size="xs" icon="trash-2">Excluir</es-button>
                    </form>
                </div>
            </td>
        </tr>
    }

    <es-data-table-empty>
        <es-empty-state icon="layout-dashboard"
                        title="Nenhum aviso ainda"
                        description="Crie um aviso para comunicar algo a todos os lojistas — uma imagem clicável na tela ou uma mensagem em modal.">
            <es-button variant="primary" icon="plus" href="/Banners/Edit">Criar primeiro aviso</es-button>
        </es-empty-state>
    </es-data-table-empty>
</es-data-table>
