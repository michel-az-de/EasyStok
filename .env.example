# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado no git.

# Connection string do banco de dados (Azure PostgreSQL ou local)
AZURE_PG_CONNECTION=Host=pg-easystock.postgres.database.azure.com;Port=5432;Database=easystock;Username=<usuario>;Password=<senha>;SSL Mode=Require;Trust Server Certificate=true

# Chave secreta JWT (mínimo 32 caracteres)
# Gerar: openssl rand -base64 32
JWT_SECRET_KEY=

# Chave-mestra (KEK) que cifra as chaves de integração das lojas (F16, #1246).
# Obrigatória em Production: sem ela a API não sobe e diz qual variável falta.
# EZ_CRYPTO_KEK_ID: nome livre e estável, ex.: kek-2026-10 (vai gravado em cada credencial).
# EZ_CRYPTO_KEK: Base64 de 32 bytes. Gerar: openssl rand -base64 32
# Rotação: a KEK antiga passa para EZ_CRYPTO_KEK_ANTERIOR_ID/EZ_CRYPTO_KEK_ANTERIOR, a nova
# entra em EZ_CRYPTO_KEK_ID/EZ_CRYPTO_KEK, e as credenciais são recifradas pela rotação.
# Perder a KEK = perder as chaves salvas (a loja cadastra de novo pela tela).
EZ_CRYPTO_KEK_ID=
EZ_CRYPTO_KEK=
EZ_CRYPTO_KEK_ANTERIOR_ID=
EZ_CRYPTO_KEK_ANTERIOR=

# Ambiente (Development | Production)
ASPNETCORE_ENVIRONMENT=Production

# Opcional
JWT_ISSUER=EasyStock
JWT_AUDIENCE=EasyStock
REDIS_CONNECTION=localhost:6379
OTLP_ENDPOINT=http://localhost:4317
