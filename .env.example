# Copie este arquivo para .env e preencha. O .env NUNCA entra no git.
# Aqui só nomes e uma linha de explicação, sem valor. Cada nome foi conferido no código que o lê
# ou no compose/script que o repassa; as chaves com __ são lidas pela API como seção:chave.
# Atenção: o docker-compose.yml deste repositório só repassa ao contêiner as variáveis dos blocos
# Banco, Ambiente, JWT e KEK; as demais chegam pelo compose da VPS ou por dotnet run local.

# ── Banco, cache e telemetria (docker-compose.yml) ───────────────────────────
# Connection string do Postgres: Host=...;Port=5432;Database=...;Username=...;Password=...
AZURE_PG_CONNECTION=
# Redis (padrão localhost:6379)
REDIS_CONNECTION=
# Collector OTLP (padrão http://localhost:4317)
OTLP_ENDPOINT=

# ── Ambiente ─────────────────────────────────────────────────────────────────
# Development | Production
ASPNETCORE_ENVIRONMENT=Production
# true/false; vazio aplica as migrations na subida fora de Production e não aplica em Production
RunMigrationsOnStartup=

# ── JWT (Jwt:*) ──────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gerar: openssl rand -base64 32
JWT_SECRET_KEY=
JWT_ISSUER=EasyStock
JWT_AUDIENCE=EasyStock

# ── KEK que cifra as chaves de integração das lojas (#1246) ──────────────────
# Obrigatória em Production: sem ela a API não sobe e diz qual variável falta.
# EZ_CRYPTO_KEK_ID: nome livre e estável, ex.: kek-2026-10 (gravado em cada credencial).
# EZ_CRYPTO_KEK: Base64 de 32 bytes. Gerar: openssl rand -base64 32
# Rotação: a KEK antiga vai para *_ANTERIOR, a nova entra em EZ_CRYPTO_KEK_ID/EZ_CRYPTO_KEK.
# Perder a KEK = perder as chaves salvas (a loja cadastra de novo pela tela).
EZ_CRYPTO_KEK_ID=
EZ_CRYPTO_KEK=
EZ_CRYPTO_KEK_ANTERIOR_ID=
EZ_CRYPTO_KEK_ANTERIOR=

# ── SuperAdmin do seed (EasyStock.Api/Data/SuperAdminSeed.cs; obrigatório em Production) ──
# Senha com 12+ caracteres e fora das listas de senhas fracas.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NOME=

# ── E-mail (seção Smtp; EasyStock.Infra.Async/Email/SmtpOpcoes.cs) ───────────
# Na VPS o compose repassa EZ_SMTP_* para Smtp__Username/Smtp__Password e Smtp__Seguranca__*
# (docs/plan/notificacoes-sistema/07-publicacao.md).
Smtp__Host=
Smtp__Port=
# Auto | SslImplicito | StartTls | Nenhum (Nenhum é recusado em Production)
Smtp__Modo=
Smtp__FromEmail=
Smtp__FromName=
# Caixa de avisos
EZ_SMTP_USER=
EZ_SMTP_PASSWORD=
# Caixa de segurança (Smtp:Seguranca:*); vazia cai na de avisos
EZ_SMTP_SEG_USER=
EZ_SMTP_SEG_PASSWORD=

# ── WhatsApp pela Meta (Notifications:WhatsApp:*; StartupHardening valida em Production) ──
# meta | stub
Notifications__WhatsApp__Provider=
# Token do usuário de sistema (→ Notifications__WhatsApp__Meta__AccessToken)
EZ_META_ACCESS_TOKEN=
# App da Meta (→ Notifications__WhatsApp__Meta__AppId)
EZ_META_APP_ID=
# Segredo do app, valida a assinatura do webhook
Notifications__WhatsApp__Meta__AppSecret=
# Token de verificação do webhook
Notifications__WhatsApp__Meta__VerifyToken=
# Configuração do Embedded Signup (→ Notifications__WhatsApp__Meta__EmbeddedSignupConfigId)
EZ_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Número da plataforma (Notifications:WhatsApp:Plataforma:*): meta | stub, id do número e verify token
EZ_WA_PLATAFORMA_PROVIDER=
EZ_WA_PLATAFORMA_PHONE_ID=
EZ_WA_PLATAFORMA_VERIFY=

# ── Mercado Pago (seção MercadoPago; EasyStock.Infra.Integrations/Pagamentos/MercadoPago/MercadoPagoOptions.cs) ──
MercadoPago__AccessToken=
# Segredo que assina os webhooks
MercadoPago__WebhookSecret=
# URL pública que recebe os webhooks
MercadoPago__NotificationUrl=
# Para onde o cliente volta depois do checkout
MercadoPago__BackUrlSuccess=
MercadoPago__BackUrlFailure=
MercadoPago__BackUrlPending=

# ── IA do atendimento (seção Anthropic; EasyStock.Infra.Integrations/Ia/AnthropicAgenteOptions.cs) ──
# false desliga o agente e o gerador de descrições (o docker-compose.yml do repositório fixa false)
Anthropic__Enabled=
Anthropic__ApiKey=
# Chave da Fireworks só para o agente (→ Anthropic__ApiKeyAgente, ADR-0058)
EZ_FIREWORKS_API_KEY=

# ── Web Push (seção WebPush; EasyStock.Infra.Notifications/Options/WebPushOptions.cs) ──
# Par VAPID gerado uma vez com VapidHelper.GenerateVapidKeys(); a privada nunca é exposta
WebPush__Subject=
WebPush__PublicKey=
WebPush__PrivateKey=

# ── Monitoramento (Notifications:Monitoring:PingUrl; EasyStock.Infra.Notifications/Hosting/HealthchecksPingService.cs) ──
# URL de ping do Healthchecks.io; vazia desliga o ping do Worker
EZ_HEALTHCHECKS_URL=
