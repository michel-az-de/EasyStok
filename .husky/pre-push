#!/bin/sh
# EasyStok — pre-push intencionalmente vazio (issue #738).
#
# O ambiente local NAO sobe mais automaticamente no push: com ~19 pushes/dia,
# o up.ps1 -Ensure (porta-em-LISTEN como verdade + .pid sobrescrito) lancava
# dotnet watch duplicado a cada janela de porta livre — os orfaos acumularam
# ate 29 processos / 5,9 GB de RAM e causavam locks MSB3021 em builds.
#
# Subir/derrubar o ambiente e acao manual:
#   pwsh scripts/local-env/up.ps1            # espera health, imprime URLs/credenciais
#   pwsh scripts/local-env/down.ps1          # encerra os watchers dos .pid
#   pwsh scripts/local-env/down.ps1 -Sweep   # + varre watchers orfaos deste repo
exit 0
