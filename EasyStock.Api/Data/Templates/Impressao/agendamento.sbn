{{ capture lista }}<div class="sec"><h2>O que vai</h2><div class="its">{{ for i in m.itens }}<div class="it"><span class="q">{{ i.quantidade }}</span><span class="n">{{ i.nome }}{{ if i.observacao }}<small>{{ i.observacao }}</small>{{ end }}</span><span class="v">{{ i.valor }}</span></div>{{ end }}</div><div class="tot"><div class="ln total"><span>Total</span><span>{{ m.total }}</span></div><p class="pago">{{ m.cobranca_frase }}</p></div>{{ if m.observacao }}<p class="barra">{{ m.observacao }}</p>{{ end }}</div>{{ end -}}
{{ capture onde }}<div class="sec"><h2>Onde entregamos</h2>{{ if m.cliente.endereco }}<p><b>{{ m.cliente.endereco }}</b></p>{{ end }}<p>{{ m.entrega }}</p></div>{{ end -}}
{{ capture qr }}{{ if m.qr }}<div class="qrl"><div><h3>Mudou o plano?</h3><p>Aponte a câmera e fale com a Casa pelo WhatsApp: a gente ajusta.</p></div>{{ m.qr }}</div>{{ end }}{{ end -}}
{{ capture fecho }}<div class="fecho">{{ m.orn }}<p class="frase">Pode deixar com a gente.</p><p class="ass">{{ m.assinatura }}</p></div>{{ end -}}
<article class="im {{ m.papel.classes }}">
<header class="cab">{{ if m.logo }}<img class="logo" src="{{ m.logo }}" alt="{{ m.casa.nome }}">{{ else }}<div class="wm">{{ m.casa.nome }}</div>{{ end }}<div class="lema">Encomenda confirmada</div></header>
<div class="id"><span class="chip">Pedido {{ m.numero }}</span><span class="quando">pedido feito em {{ m.solicitado }}</span></div>
<h1>{{ if m.cliente.primeiro }}{{ m.cliente.primeiro }}, combinado: {{ else }}Combinado: {{ end }}{{ m.prazo.dia_longo }}, {{ m.prazo.janela_longa }}.</h1>
{{ if m.alergias }}<p class="barra">Anotado: alergia a {{ m.alergias }}.</p>{{ end }}
{{ if m.papel.largo }}<div class="cols"><div class="folha">{{ lista }}{{ fecho }}</div><aside class="painel">{{ onde }}{{ qr }}</aside></div>
{{ else }}{{ lista }}<div class="f">{{ if m.papel.etiqueta }}{{ if m.cliente.endereco }}<p><b>{{ m.cliente.endereco }}</b></p>{{ end }}{{ else }}{{ onde }}{{ end }}</div>{{ if m.qr }}<div class="f">{{ qr }}</div>{{ end }}{{ fecho }}
{{ end }}<footer class="pe">{{ for c in m.casa.contatos }}<span>{{ c }}</span>{{ if !for.last }} · {{ end }}{{ end }}<br><span>#{{ m.numero }} · impresso {{ m.impresso }}</span></footer>
</article>
