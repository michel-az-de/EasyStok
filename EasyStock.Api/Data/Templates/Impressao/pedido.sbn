{{ capture lista }}<div class="sec"><h2>Seu pedido</h2><div class="its">{{ for i in m.itens }}<div class="it"><span class="q">{{ i.quantidade }}</span><span class="n">{{ i.nome }}{{ if i.observacao }}<small>{{ i.observacao }}</small>{{ end }}</span><span class="v">{{ i.valor }}</span></div>{{ end }}</div><div class="tot"><div class="ln total"><span>Total</span><span>{{ m.total }}</span></div><p class="pago">{{ m.cobranca_frase }}</p></div>{{ if m.observacao }}<p class="barra">{{ m.observacao }}</p>{{ end }}{{ if m.nota }}<p class="barra">{{ m.nota }}</p>{{ end }}</div>{{ end -}}
{{ capture onde }}<div class="sec"><h2>Entrega</h2>{{ if m.cliente.endereco }}<p><b>{{ m.cliente.endereco }}</b></p>{{ end }}<p>{{ m.prazo.dia_longo }}, {{ m.prazo.janela_longa }}<br>{{ m.entrega }}</p></div>{{ end -}}
{{ capture qr }}{{ if m.qr }}<div class="qrl"><div>{{ if m.codigo_barras }}<h3>Código do pedido</h3><p>#{{ m.numero }}</p>{{ else }}<h3>Faltou algo? Quer repetir?</h3><p>Aponte a câmera e fale direto com a Casa pelo WhatsApp.</p>{{ end }}</div>{{ m.qr }}</div>{{ end }}{{ end -}}
{{ capture fecho }}<div class="fecho">{{ m.orn }}<p class="frase">Feito com cuidado, acompanhado de perto.</p><p class="ass">{{ m.assinatura }}</p></div>{{ end -}}
<article class="im {{ m.papel.classes }}">
<header class="cab">{{ if m.logo }}<img class="logo" src="{{ m.logo }}" alt="{{ m.casa.nome }}">{{ else }}<div class="wm">{{ m.casa.nome }}</div>{{ end }}<div class="lema">Da nossa casa para a sua mesa</div></header>
<div class="id"><span class="chip">Pedido {{ m.numero }}</span><span class="quando">{{ m.prazo.data_longa }} · {{ m.prazo.hora_curta }}</span></div>
<h1>{{ if m.cliente.primeiro }}{{ m.cliente.primeiro }}, vamos à mesa?{{ else }}Vamos à mesa?{{ end }}</h1>
{{ if m.papel.largo }}<div class="cols"><div class="folha">{{ lista }}{{ fecho }}</div><aside class="painel">{{ onde }}{{ qr }}</aside></div>
{{ else }}{{ lista }}{{ if !m.papel.etiqueta }}<div class="f">{{ onde }}</div>{{ end }}{{ if m.qr }}<div class="f">{{ qr }}</div>{{ end }}{{ fecho }}
{{ end }}<footer class="pe">{{ for c in m.casa.contatos }}<span>{{ c }}</span>{{ if !for.last }} · {{ end }}{{ end }}<br><span>#{{ m.numero }} · impresso {{ m.impresso }}</span></footer>
</article>
