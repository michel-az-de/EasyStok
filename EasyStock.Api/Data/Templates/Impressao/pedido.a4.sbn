<div class="e4">
<div class="ehead">{{ if m.casa.logo_url }}<img class="elogo" src="{{ m.casa.logo_url }}" alt="{{ m.casa.nome }}">{{ else }}<div class="ewm">{{ m.casa.nome }}</div>{{ end }}<div class="econt">{{ for c in m.casa.contatos }}<span>{{ c }}</span>{{ end }}</div></div>
<div class="erow" style="align-items:center"><div><span class="el">Pedido</span><span class="ecode"><b>#{{ m.numero }}</b></span><br><span class="estamp">{{ m.prazo.selo }}</span></div>
<div class="g"><span class="el">{{ m.prazo.rotulo_data }}</span><span class="ebig">{{ m.prazo.data_longa }}</span></div>
<div class="g"><span class="el">{{ m.prazo.rotulo_hora }}</span><span class="ebig">{{ m.prazo.hora_longa }}</span></div>
<div class="eprazo"><span class="el">Pronto até</span><span class="ebig">{{ m.prazo.pronto_ate }}</span></div></div>
<div class="erow"><div class="g"><span class="el">Solicitado</span><b>{{ m.solicitado_longo }}</b></div><div class="g"><span class="el">Entregador</span><b>{{ m.entrega }}</b></div><div class="g"><span class="el">Pagamento</span><b>{{ m.cobranca.rotulo }}</b></div></div>
<div class="erow"><div class="g"><span class="el">Cliente{{ if m.cliente.id }} · ID #{{ m.cliente.id }}{{ end }}</span><div class="ecname">{{ m.cliente.nome }}</div>{{ m.cliente.endereco }}</div>{{ if m.cliente.telefone }}<div><span class="el">Telefone</span><span class="ephone">{{ m.cliente.telefone }}</span></div>{{ end }}</div>
<table><thead><tr><th class="c">Qtd</th><th>Item</th><th class="d">Unitário</th><th class="d">Total</th></tr></thead><tbody>
{{ for i in m.itens }}<tr><td class="eq">{{ i.quantidade }}</td><td><div class="en">{{ i.nome }}</div>{{ if i.observacao }}<div class="eobs">{{ i.observacao }}</div>{{ end }}</td><td class="ev">{{ i.unitario }}</td><td class="ev">{{ i.subtotal }}</td></tr>
{{ end }}</tbody></table>
{{ if m.observacao || m.nota }}<div class="erow enotas">{{ if m.observacao }}<div class="g"><span class="el">Observação</span>{{ m.observacao }}</div>{{ end }}{{ if m.nota }}<div class="g enota"><span class="el">Nota</span>{{ m.nota }}</div>{{ end }}</div>{{ end }}
<div class="espacer"></div>
<div class="etot"><span class="el">{{ m.cobranca.rotulo }} · {{ m.quantidade_total }}</span><span class="ebig">{{ m.cobranca.total }}</span></div>
<div class="ebar">{{ m.barras }}<div class="ebar-txt">{{ m.numero }}</div></div>
<div class="emeta"><span>Alterado {{ m.alterado_longo }}</span><span>Impresso {{ m.impresso_longo }}</span></div>
</div>
